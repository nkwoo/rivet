{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "메인 창에 허용하는 최소 권한. 새 명령은 필요한 것만 추가합니다.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-profile-list",
    "allow-profile-create",
    "allow-profile-update",
    "allow-profile-delete",
    "allow-profile-forget-secret",
    "allow-ssh-config-scan",
    "allow-known-hosts-list",
    "allow-known-hosts-remove",
    "allow-cert-pins-list",
    "allow-cert-pins-remove",
    "allow-ftp-connect",
    "allow-rdp-connect",
    "allow-rdp-input",
    "allow-rdp-resize",
    "allow-rdp-frame-ack",
    "allow-rdp-clipboard",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-close",
    "allow-ssh-host-key-respond",
    "allow-local-home",
    "allow-local-list",
    "allow-sftp-open",
    "allow-sftp-list",
    "allow-sftp-mkdir",
    "allow-sftp-rename",
    "allow-sftp-remove",
    "allow-transfer-subscribe",
    "allow-transfer-upload",
    "allow-transfer-download",
    "allow-transfer-resolve",
    "allow-transfer-cancel",
    "allow-transfer-retry",
    "allow-transfer-clear-finished",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-set-fullscreen"
  ]
}
